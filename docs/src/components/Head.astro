---
// Starlight emits every OpenGraph tag except the image, so the generated card
// from `src/pages/og/[...route].ts` is added here. The card is keyed by the
// page's path within the site; anything with no card of its own (the 404 page)
// gets the site one.
import Default from '@astrojs/starlight/components/Head.astro';
import { getCollection } from 'astro:content';
import { listPydocsPages } from 'starlight-pydocs/pages';
import context from 'virtual:starlight-pydocs/context';

const written = new Set((await getCollection('docs')).map((entry) => entry.id));
const generated = new Set((await listPydocsPages(context)).map((page) => page.slug));
const cards = new Set([...written, ...generated]);

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.slice(base.length).replace(/^\/|\/$/g, '') || 'index';
const image = new URL(`${base}/og/${cards.has(path) ? path : 'index'}.png`.replace(/\/{2,}/g, '/'), Astro.site);

// Every page is also served as Markdown, so say so in the head rather than
// leaving a crawler to guess the `.md` convention. starlight-page-actions
// writes those files for the pages in `src/content/docs` but adds no link tag.
// The generated pages carry their own, from the plugin's route, so they are
// excluded here instead of being advertised twice.
const markdown = written.has(path) && !generated.has(path) ? `${base}/${path}.md`.replace(/\/{2,}/g, '/') : undefined;
---

<Default><slot /></Default>
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
{markdown === undefined ? null : <link rel="alternate" type="text/markdown" href={markdown} />}
