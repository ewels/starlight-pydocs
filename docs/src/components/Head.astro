---
// Starlight emits every OpenGraph tag except the image, so the generated card
// from `src/pages/og/[...route].ts` is added here. Pages with no generated card
// (the injected API reference routes) get the site one.
import Default from '@astrojs/starlight/components/Head.astro';
import { getCollection } from 'astro:content';

const ids = new Set((await getCollection('docs')).map((entry) => entry.id));
const { id } = Astro.locals.starlightRoute;
const image = new URL(
  `${import.meta.env.BASE_URL}/og/${ids.has(id) ? id : 'index'}.png`.replace(/\/{2,}/g, '/'),
  Astro.site,
);
---

<Default><slot /></Default>
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
