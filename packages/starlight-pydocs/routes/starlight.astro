---
/**
 * The generated module pages, under Starlight.
 *
 * `StarlightPage` gets `frontmatter` and `headings` as props: that is what
 * feeds the table of contents for an injected route, and it renders the standard
 * page shell so Pagefind indexes the content. Prerendering comes from the
 * `injectRoute` call, not an export (eslint rejects the export outside
 * `src/pages`, and the flag is sufficient).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import context from 'virtual:starlight-pydocs/context';
import { ModuleDoc } from 'virtual:starlight-pydocs/components';

import SymbolSearch from '../components/SymbolSearch.astro';
import type { PydocsRouteProps } from '../libs/route.ts';
import { getPydocsStaticPaths, resolvePydocsPage } from '../libs/route.ts';

export async function getStaticPaths() {
  return getPydocsStaticPaths(context);
}

type Props = PydocsRouteProps;

const props = Astro.props;
const { scope, page, withSearch } = await resolvePydocsPage(context, props);
---

<StarlightPage frontmatter={{ title: page.title, pagefind: true }} headings={page.headings}>
  {withSearch ? <SymbolSearch package={props.pydocsBase} /> : null}
  <ModuleDoc doc={page.object} scope={scope} />
</StarlightPage>
