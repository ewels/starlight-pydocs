---
/**
 * Parameter, other-parameter, type-parameter and attribute sections.
 *
 * A table rather than a definition list: these entries genuinely have columns
 * (name, type, default, description), and the column headings are already part
 * of the translated strings.
 */
import { renderedSectionEntry } from '../../lib/docstrings.ts';
import { annotationTokens } from '../../lib/expr.ts';
import { createStringResolver } from '../../lib/i18n.ts';
import { unwrapParagraph } from '../../lib/markdown.ts';
import type { DocObject } from '../../lib/model.ts';
import type { RenderScope } from '../../lib/render.ts';
import type { StringKey, StringOverrides } from '../../lib/strings.ts';
import type { DocstringSectionNamedValues } from '../../lib/types.ts';
import AnnotationTokens from '../AnnotationTokens.astro';

interface Props {
  section: DocstringSectionNamedValues;
  /** Index of the section in the object's parsed docstring, to find its prose. */
  sectionIndex: number;
  doc: DocObject;
  scope: RenderScope;
  /** Which heading this section gets. */
  headingKey: StringKey;
  /** Show the default-value column. */
  withDefaults?: boolean | undefined;
  labels?: StringOverrides | undefined;
}

const { section, sectionIndex, doc, scope, headingKey, withDefaults = false, labels } = Astro.props;

const resolve = createStringResolver(Astro.locals, labels);
const entries = Array.isArray(section.value) ? section.value : [];

// `annotationTokens` takes a missing annotation and returns no tokens, so an
// entry without a type or a default needs no guard here.
const rows = entries.map((entry, index) => ({
  name: entry.name ?? '',
  annotation: annotationTokens(entry.annotation, doc.path, scope.resolver),
  default: annotationTokens(entry.value, doc.path, scope.resolver),
  description: unwrapParagraph(renderedSectionEntry(scope.rendered, doc.canonicalPath, sectionIndex, index)),
}));

const showDefaults = withDefaults && rows.some((row) => row.default.length > 0);
const showTypes = rows.some((row) => row.annotation.length > 0);
---

{
  rows.length === 0 ? null : (
    <div class="pyd-section" data-pydocs-section={section.kind}>
      <p class="pyd-section-title">{resolve(headingKey)}</p>
      <div class="pyd-table-wrap">
        <table class="pyd-params">
          <thead>
            <tr>
              <th scope="col">{resolve('columnName')}</th>
              {showTypes && <th scope="col">{resolve('columnType')}</th>}
              {showDefaults && <th scope="col">{resolve('columnDefault')}</th>}
              <th scope="col">{resolve('columnDescription')}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row" class="pyd-param-name">
                  <code>{row.name}</code>
                </th>
                {showTypes && (
                  <td class="pyd-param-type">
                    {row.annotation.length === 0 ? null : (
                      <code>
                        <AnnotationTokens tokens={row.annotation} scope={scope} />
                      </code>
                    )}
                  </td>
                )}
                {showDefaults && (
                  <td class="pyd-param-default">
                    {row.default.length === 0 ? (
                      <span class="pyd-required">{resolve('required')}</span>
                    ) : (
                      <code>
                        <AnnotationTokens tokens={row.default} scope={scope} />
                      </code>
                    )}
                  </td>
                )}
                <td class="pyd-param-description" set:html={row.description} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )
}
