---
/**
 * Client-side symbol search over one package's `symbols.json`.
 *
 * Pagefind already searches the prose; this searches the API surface by name,
 * which is what people actually type. The index is fetched on first focus, not
 * on load, so a page that nobody searches costs nothing.
 */
import { matchPackageReference } from '../lib/context.ts';
import { createStringResolver } from '../lib/i18n.ts';
import { assetHref, slugifyBase } from '../lib/paths.ts';
import type { StringKey, StringOverrides } from '../lib/strings.ts';
import { loadPydocsContext } from './context.ts';

interface Props {
  /**
   * Which configured entry to search: a package base, or an import name when
   * only one entry documents that package. Defaults to the first entry.
   */
  package?: string | undefined;
  class?: string | undefined;
  labels?: StringOverrides | undefined;
}

const { package: packageReference, class: className, labels } = Astro.props;

const context = await loadPydocsContext('SymbolSearch');
const match = packageReference === undefined ? undefined : matchPackageReference(context, packageReference);
// An ambiguous or unknown reference searches nothing rather than guessing which
// version of a package the author meant.
const pkg = match === undefined ? context.packages[0] : match.kind === 'match' ? match.pkg : undefined;

const resolve = createStringResolver(Astro.locals, labels);

const KIND_LABEL_KEYS: Record<string, StringKey> = {
  module: 'kindModule',
  class: 'kindClass',
  function: 'kindFunction',
  attribute: 'kindAttribute',
  alias: 'kindAlias',
};

const kindLabels = Object.fromEntries(Object.entries(KIND_LABEL_KEYS).map(([kind, key]) => [kind, resolve(key)]));

const symbolsUrl = pkg === undefined ? undefined : assetHref(context.siteBase, pkg.base, 'symbols.json');
// Ids come from the base, not the name: two boxes on one page searching two
// documented versions of the same package would otherwise share their ids.
const idSuffix = pkg === undefined ? 'pydocs' : slugifyBase(pkg.base);
const inputId = `pyd-search-input-${idSuffix}`;
const listId = `pyd-search-list-${idSuffix}`;
---

{
  symbolsUrl === undefined || !context.symbolSearch ? null : (
    <pydocs-search
      class:list={['pyd-search', className]}
      data-symbols-url={symbolsUrl}
      data-site-base={context.siteBase}
      data-trailing-slash={context.trailingSlash}
      data-kind-labels={JSON.stringify(kindLabels)}
      data-no-results={resolve('searchNoResults')}
      data-results-label={resolve('searchResults')}
    >
      <label class="pyd-search-label" for={inputId}>
        {resolve('searchLabel')}
      </label>
      <input
        id={inputId}
        class="pyd-search-input"
        type="text"
        role="combobox"
        autocomplete="off"
        spellcheck="false"
        placeholder={resolve('searchPlaceholder')}
        aria-controls={listId}
        aria-expanded="false"
        aria-autocomplete="list"
      />
      <p class="pyd-search-hint">{resolve('searchHint')}</p>
      <div class="pyd-search-results" id={listId} role="listbox" aria-label={resolve('searchResults')} hidden />
    </pydocs-search>
  )
}

<script>
  import {
    groupMatchesByKind,
    matchHref,
    matchSymbols,
    type SearchEntry,
    type SearchLinkOptions,
  } from '../lib/search-match';

  interface SymbolsPayload {
    package: string;
    generated: string;
    symbols: SearchEntry[];
  }

  /** Every node in a result row is a class plus some text, so make one here. */
  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className: string,
    text?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  class PydocsSearchElement extends HTMLElement {
    #input: HTMLInputElement | null = null;
    #results: HTMLElement | null = null;
    #entries: SearchEntry[] | undefined;
    #loading: Promise<void> | undefined;
    #options: HTMLAnchorElement[] = [];
    #active = -1;
    /** Labels and link options, read off the dataset once instead of per keystroke. */
    #kindLabels: Record<string, string> = {};
    #linkOptions: SearchLinkOptions = { siteBase: '', trailingSlash: 'always' };

    connectedCallback() {
      // Query `this`, never the document: view transitions create a fresh
      // element per navigation and several may share a page.
      this.#input = this.querySelector('input.pyd-search-input');
      this.#results = this.querySelector('.pyd-search-results');
      if (!this.#input || !this.#results) return;

      this.#kindLabels = JSON.parse(this.dataset['kindLabels'] ?? '{}') as Record<string, string>;
      this.#linkOptions = {
        siteBase: this.dataset['siteBase'] ?? '',
        trailingSlash: (this.dataset['trailingSlash'] ?? 'always') as 'always' | 'never' | 'ignore',
      };

      this.#input.addEventListener('focus', () => void this.#load());
      this.#input.addEventListener('input', () => void this.#render());
      this.#input.addEventListener('keydown', (event) => this.#onKeydown(event));
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget as Node | null)) this.#close();
      });
    }

    async #load() {
      if (this.#entries || this.#loading) return this.#loading;
      const url = this.dataset['symbolsUrl'];
      if (!url) return;
      this.#loading = fetch(url)
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error(String(response.status)))))
        .then((payload: SymbolsPayload) => {
          this.#entries = Array.isArray(payload.symbols) ? payload.symbols : [];
        })
        .catch(() => {
          this.#entries = [];
        });
      return this.#loading;
    }

    async #render() {
      await this.#load();
      const input = this.#input;
      const results = this.#results;
      if (!input || !results) return;

      const query = input.value;
      if (query.trim() === '') {
        this.#close();
        return;
      }

      const matches = matchSymbols(this.#entries ?? [], query);
      const options: HTMLAnchorElement[] = [];

      results.textContent = '';
      if (matches.length === 0) {
        results.append(element('p', 'pyd-search-empty', this.dataset['noResults'] ?? 'No matching symbols'));
      } else {
        for (const group of groupMatchesByKind(matches)) {
          const label = this.#kindLabels[group.kind] ?? group.kind;
          const section = element('div', 'pyd-search-group');
          section.setAttribute('role', 'group');
          section.setAttribute('aria-label', label);
          section.append(element('p', 'pyd-search-group-label', label));

          for (const match of group.matches) {
            const option = element('a', 'pyd-search-option');
            option.setAttribute('role', 'option');
            option.setAttribute('aria-selected', 'false');
            option.id = `pyd-search-option-${String(options.length)}`;
            option.href = matchHref(match, this.#linkOptions);
            option.dataset['kind'] = match.entry.kind;
            option.append(
              element('span', 'pyd-search-option-name', match.name),
              element('span', 'pyd-search-option-path', match.entry.path),
            );
            if (match.entry.brief) {
              option.append(element('span', 'pyd-search-option-brief', match.entry.brief));
            }

            section.append(option);
            options.push(option);
          }
          results.append(section);
        }
      }

      // Collected while building, so the ids are unique and nothing has to be
      // queried back out of the DOM.
      this.#options = options;
      this.#active = -1;
      results.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      input.removeAttribute('aria-activedescendant');
    }

    #onKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        this.#close();
        return;
      }
      if (event.key === 'Enter') {
        const active = this.#options[this.#active];
        if (active) {
          event.preventDefault();
          active.click();
        }
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      if (this.#options.length === 0) return;
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      this.#active = (this.#active + step + this.#options.length) % this.#options.length;
      this.#options.forEach((option, index) => {
        const selected = index === this.#active;
        option.setAttribute('aria-selected', selected ? 'true' : 'false');
        option.classList.toggle('pyd-search-option--active', selected);
        if (selected) {
          this.#input?.setAttribute('aria-activedescendant', option.id);
          option.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    #close() {
      if (this.#results) {
        this.#results.hidden = true;
        this.#results.textContent = '';
      }
      this.#options = [];
      this.#active = -1;
      this.#input?.setAttribute('aria-expanded', 'false');
      this.#input?.removeAttribute('aria-activedescendant');
    }
  }

  // Define once: view transitions re-run this script per navigation.
  if (!customElements.get('pydocs-search')) {
    customElements.define('pydocs-search', PydocsSearchElement);
  }
</script>
