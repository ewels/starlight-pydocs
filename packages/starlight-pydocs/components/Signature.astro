---
/**
 * A signature block with linked annotations.
 *
 * Built from griffe's parameter list rather than source text, so the `/` and
 * `*` markers land in the right places (see `lib/signature.ts`). Classes show
 * their `__init__` parameters, the mkdocstrings convention. `@overload`
 * variants stack above the implementation when the dump carries them.
 *
 * Long signatures wrap rather than overflow: the layout is CSS's decision, made
 * from the `pyd-signature--multiline` class this component adds once a
 * signature has more than three parameters.
 *
 * An attribute's value can be arbitrarily large (a dict of dicts, a table of
 * themes). Those are line-broken at their brackets, then clamped behind a
 * toggle so a page of constants stays readable.
 *
 * The toggle is a checkbox inside its label, not a `<details>`. The block has
 * to stay visible while collapsed, because its first line carries the name and
 * the type, and a `<details>` hides everything that is not its `<summary>`.
 * Putting the whole block inside the `<summary>` instead — which is what this
 * did first — is invalid (`<summary>` takes phrasing content, not a `<pre>`)
 * and breaks every cross-reference in the signature: a click on a link inside a
 * `<summary>` toggles the disclosure as well as following the link. No script
 * either way.
 *
 * The checkbox is wrapped by its label rather than paired by `id`, so the block
 * carries no id at all: the same object can be rendered twice on one page (two
 * `<Autodoc>` blocks naming it), and duplicate ids would point both toggles at
 * the first checkbox.
 *
 * Colours come from the host's Shiki themes and the cross-reference links
 * survive the pass. Nothing is highlighted here: the colours were computed at
 * `astro:config:done` and are looked up by signature text; see
 * `lib/highlight.ts`.
 */
import { createStringResolver } from '../lib/i18n.ts';
import { tokensText } from '../lib/expr.ts';
import { highlightTokens } from '../lib/highlight.ts';
import type { DocObject } from '../lib/model.ts';
import type { RenderScope } from '../lib/render.ts';
import { displaySignatureTokens, overloadSignatureTokens, renderedParameterCount } from '../lib/signature.ts';
import type { StringOverrides } from '../lib/strings.ts';
import AnnotationTokens from './AnnotationTokens.astro';

/**
 * Lines of signature text beyond which the block folds.
 *
 * Lines, not characters: the collapsed state is a `max-height` clamp of about
 * seven lines, so a character count promises a fold that a wide viewport then
 * does not deliver — a "Show more" under a block that is already whole, doing
 * nothing when clicked. Only an attribute's value is broken across lines
 * (`displaySignatureTokens`), so only an attribute can reach this.
 */
const FOLD_LINES = 8;

interface Props {
  doc: DocObject;
  scope: RenderScope;
  labels?: StringOverrides | undefined;
  class?: string | undefined;
}

const { doc, scope, labels, class: className } = Astro.props;

const resolve = createStringResolver(Astro.locals, labels);
const options = { resolver: scope.resolver };
const wrapped = displaySignatureTokens(doc, options);
const { highlights } = scope;
const tokens = highlightTokens(wrapped, highlights);
const overloads = (doc.overloads ?? []).map((overload) =>
  highlightTokens(overloadSignatureTokens(overload, doc, options), highlights),
);
const multiline = renderedParameterCount(doc) > 3;
const folded = tokensText(wrapped).split('\n').length > FOLD_LINES;
// `<pre>` keeps every space in the template, so the block is written on one
// line in both branches below and the class list is built here instead.
const signatureClass = ['pyd-signature', multiline && 'pyd-signature--multiline', className];
---

{
  overloads.map((overload) =>
    /* prettier-ignore */
    <pre class="pyd-signature pyd-signature--overload" data-pydocs-signature="overload"><code><span class="pyd-decorator">@overload</span> <AnnotationTokens tokens={overload} scope={scope} labels={labels} /></code></pre>,
  )
}{
  folded ? (
    <div class="pyd-fold">
      {/* prettier-ignore */}
      <pre class:list={signatureClass} data-pydocs-signature={doc.path}><code><AnnotationTokens tokens={tokens} scope={scope} labels={labels} /></code></pre>
      <label class="pyd-fold-toggle">
        <input class="pyd-fold-input" type="checkbox" />
        <span data-pydocs-fold="more">{resolve('showMore')}</span>
        <span data-pydocs-fold="less">{resolve('showLess')}</span>
      </label>
    </div>
  ) : (
    /* prettier-ignore */
    <pre class:list={signatureClass} data-pydocs-signature={doc.path}><code><AnnotationTokens tokens={tokens} scope={scope} labels={labels} /></code></pre>
  )
}
