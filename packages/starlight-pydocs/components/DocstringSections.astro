---
/**
 * Every parsed docstring section of one object, in docstring order.
 *
 * Prose comes from the pre-rendered sidecar, addressed by the object's canonical
 * path and the section's index in the docstring, so this component passes both
 * down and renders no markdown itself.
 *
 * `deprecated` sections and the `Deprecated:` admonition (which the google parser
 * routes through `admonition`, see HANDOFF.md) are skipped here: the deprecation
 * badge and note in `ObjectDoc` already carry that content.
 *
 * Unknown section kinds are ignored rather than guessed at, so a future griffe
 * release cannot break a page.
 */
import { renderedSectionBody } from '../lib/docstrings.ts';
import type { DocObject } from '../lib/model.ts';
import type { RenderScope } from '../lib/render.ts';
import type { StringKey, StringOverrides } from '../lib/strings.ts';
import type {
  DocstringSection,
  DocstringSectionAdmonition,
  DocstringSectionExamples,
  DocstringSectionNamedValues,
  DocstringSectionReferences,
  DocstringSectionThrown,
} from '../lib/types.ts';
import Markdown from './Markdown.astro';
import SectionAdmonition from './sections/SectionAdmonition.astro';
import SectionExamples from './sections/SectionExamples.astro';
import SectionNamedValues from './sections/SectionNamedValues.astro';
import SectionReferences from './sections/SectionReferences.astro';
import SectionThrown from './sections/SectionThrown.astro';
import SectionValues from './sections/SectionValues.astro';

interface Props {
  doc: DocObject;
  scope: RenderScope;
  labels?: StringOverrides | undefined;
}

const { doc, scope, labels } = Astro.props;

/** How one section kind is rendered. */
interface SectionPlan {
  renderer: 'namedValues' | 'values' | 'thrown' | 'references';
  heading: StringKey;
  /** Only parameters carry defaults; the column is dropped everywhere else. */
  withDefaults?: boolean;
}

/**
 * Every section kind that becomes a table or a list, and what it becomes. Text,
 * examples and admonitions are not here: they take different props, so they stay
 * explicit below.
 */
const SECTION_PLANS: Record<string, SectionPlan> = {
  parameters: { renderer: 'namedValues', heading: 'parameters', withDefaults: true },
  'other parameters': { renderer: 'namedValues', heading: 'otherParameters', withDefaults: true },
  'type parameters': { renderer: 'namedValues', heading: 'typeParameters' },
  attributes: { renderer: 'namedValues', heading: 'attributes' },
  returns: { renderer: 'values', heading: 'returns' },
  yields: { renderer: 'values', heading: 'yields' },
  receives: { renderer: 'values', heading: 'receives' },
  raises: { renderer: 'thrown', heading: 'raises' },
  warns: { renderer: 'thrown', heading: 'warns' },
  functions: { renderer: 'references', heading: 'functions' },
  classes: { renderer: 'references', heading: 'classes' },
  modules: { renderer: 'references', heading: 'modules' },
  'type aliases': { renderer: 'references', heading: 'typeAliases' },
};

/** True for the admonition the google parser makes of a `Deprecated:` block. */
function isDeprecationAdmonition(section: DocstringSection): boolean {
  return section.kind === 'admonition' && (section as DocstringSectionAdmonition).value?.annotation === 'deprecated';
}

// Indices are kept because the sidecar is keyed by them.
const sections = (doc.docstring?.sections ?? [])
  .map((section, index) => ({ section, index }))
  .filter(({ section }) => section.kind !== 'deprecated' && !isDeprecationAdmonition(section));
---

{
  sections.map(({ section, index }) => {
    if (section.kind === 'text') {
      return <Markdown html={renderedSectionBody(scope.rendered, doc.canonicalPath, index)} />;
    }
    if (section.kind === 'examples') {
      return (
        <SectionExamples
          section={section as DocstringSectionExamples}
          sectionIndex={index}
          doc={doc}
          scope={scope}
          labels={labels}
        />
      );
    }
    if (section.kind === 'admonition') {
      return (
        <SectionAdmonition
          section={section as DocstringSectionAdmonition}
          sectionIndex={index}
          doc={doc}
          scope={scope}
        />
      );
    }

    const plan = SECTION_PLANS[section.kind];
    if (plan === undefined) return null;
    const common = { sectionIndex: index, doc, scope, headingKey: plan.heading, labels };

    switch (plan.renderer) {
      case 'namedValues':
        return (
          <SectionNamedValues
            section={section as DocstringSectionNamedValues}
            withDefaults={plan.withDefaults ?? false}
            {...common}
          />
        );
      case 'values':
        return <SectionValues section={section as DocstringSectionNamedValues} {...common} />;
      case 'thrown':
        return <SectionThrown section={section as DocstringSectionThrown} {...common} />;
      case 'references':
        return <SectionReferences section={section as DocstringSectionReferences} {...common} />;
    }
  })
}
